# Variables à charger explicitement dans le shell, ou dans Render.
# Sans DATABASE_URL : SQLite local. Sur Render : PostgreSQL obligatoire.
DATABASE_URL=
ASF_DATA_DIR=./data
ASF_ENV=development
ASF_SECURE_COOKIE=0
# Au moins 24 caractères aléatoires ; utilisé une seule fois pour créer l'enseignant.
ASF_SETUP_TOKEN=
# Requis pour l'inscription élève sur l'environnement hébergé.
ASF_INVITE_CODE=
